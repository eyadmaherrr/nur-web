# Resend (https://resend.com) — full-access key (Audiences, Contacts, Broadcasts, Emails).
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM="Nur <hello@downloadnur.com>"
# The "Nur waitlist" audience — signups are added here as contacts.
RESEND_AUDIENCE_ID=

# Bearer secret required to call /api/announce-launch.
LAUNCH_ANNOUNCE_SECRET=

# Store links used in the launch-announcement email. Leave a platform blank
# until it's actually live there — /api/announce-launch only links to the
# ones that are set.
GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.eyadmaher.nur
APPLE_APP_STORE_URL=
