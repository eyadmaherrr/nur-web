# Resend (https://resend.com) — used to email waitlist signups.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM="Nur <hello@downloadnur.com>"
# Where new-signup notifications are sent (see app/api/subscribe).
WAITLIST_OWNER_EMAIL=hello@downloadnur.com

# Bearer secret required to call /api/announce-launch.
LAUNCH_ANNOUNCE_SECRET=
# Linked from the "Nur is on Google Play" announcement email.
GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.eyadmaher.nur
